<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>embedded</DebugType>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>CMBDevClaw.NativeDesktop.Interop</AssemblyName>
    <RootNamespace>Microsoft.Windows.SDK.BuildTools.WinApp.UIAutomation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>true</EnableNETAnalyzers><AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)OwnershipGenerated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Order is contractual for locked source-generator attribute selection; the generated stubs below are verified. -->
    <Compile Include="Services/NativeDesktopComDeclarations.cs" />
    <Compile Include="Services/NativeDesktopComOwnership.cs" />
    <Compile Include="Services/NativeDesktopAutomation.cs" />
    <Compile Include="Models/UiControlTypes.cs" />
    <Compile Include="Models/UiInvokeAction.cs" />
    <Compile Include="Capture/IFrameGrabber.cs" />
    <Compile Include="Capture/CapturedFrame.cs" />
    <Compile Include="Capture/WgcCapture.cs" />
    <Compile Include="Capture/WgcCapture.FrameGrabber.cs" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Windows.CsWin32"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>

  <!-- Caller metadata is a closed list. Outputs supplies only the target batching
       identity; without Inputs every bucket is checked on each CoreCompile invocation. -->
  <ItemGroup>
    <_CmbOwnedComCaller Include="root" Stub="Microsoft.Interop.ComInterfaceGenerator/Microsoft.Interop.ComInterfaceGenerator/Windows.Win32.UI.Accessibility.IUIAutomation.cs" Marker="IUIAutomation.ElementFromHandle(" Interface="Windows.Win32.UI.Accessibility.IUIAutomationElement" Raw="__retVal_native" />
    <_CmbOwnedComCaller Include="control-walker" Stub="Microsoft.Interop.ComInterfaceGenerator/Microsoft.Interop.ComInterfaceGenerator/Windows.Win32.UI.Accessibility.IUIAutomation.cs" Marker="IUIAutomation.get_ControlViewWalker(" Interface="Windows.Win32.UI.Accessibility.IUIAutomationTreeWalker" Raw="__retVal_native" />
    <_CmbOwnedComCaller Include="raw-walker" Stub="Microsoft.Interop.ComInterfaceGenerator/Microsoft.Interop.ComInterfaceGenerator/Windows.Win32.UI.Accessibility.IUIAutomation.cs" Marker="IUIAutomation.get_RawViewWalker(" Interface="Windows.Win32.UI.Accessibility.IUIAutomationTreeWalker" Raw="__retVal_native" />
    <_CmbOwnedComCaller Include="first-child" Stub="Microsoft.Interop.ComInterfaceGenerator/Microsoft.Interop.ComInterfaceGenerator/Windows.Win32.UI.Accessibility.IUIAutomationTreeWalker.cs" Marker="IUIAutomationTreeWalker.GetFirstChildElement(" Interface="Windows.Win32.UI.Accessibility.IUIAutomationElement" Raw="__retVal_native" />
    <_CmbOwnedComCaller Include="next-sibling" Stub="Microsoft.Interop.ComInterfaceGenerator/Microsoft.Interop.ComInterfaceGenerator/Windows.Win32.UI.Accessibility.IUIAutomationTreeWalker.cs" Marker="IUIAutomationTreeWalker.GetNextSiblingElement(" Interface="Windows.Win32.UI.Accessibility.IUIAutomationElement" Raw="__retVal_native" />
    <_CmbOwnedComCaller Include="document" Stub="Microsoft.Interop.ComInterfaceGenerator/Microsoft.Interop.ComInterfaceGenerator/Windows.Win32.UI.Accessibility.IUIAutomationTextPattern.cs" Marker="IUIAutomationTextPattern.get_DocumentRange(" Interface="Windows.Win32.UI.Accessibility.IUIAutomationTextRange" Raw="__retVal_native" />
    <_CmbOwnedComCaller Include="enclosing" Stub="Microsoft.Interop.ComInterfaceGenerator/Microsoft.Interop.ComInterfaceGenerator/Windows.Win32.UI.Accessibility.IUIAutomationTextRange.cs" Marker="IUIAutomationTextRange.GetEnclosingElement(" Interface="Windows.Win32.UI.Accessibility.IUIAutomationElement" Raw="__retVal_native" />
    <_CmbOwnedComCaller Include="d3d-device" Stub="Microsoft.Interop.LibraryImportGenerator/Microsoft.Interop.LibraryImportGenerator/LibraryImports.g.cs" Marker="D3D11CreateDevice(" Interface="Windows.Win32.Graphics.Direct3D11.ID3D11Device" Raw="__ppDevice_native" />
    <_CmbOwnedComCaller Include="d3d-context" Stub="Microsoft.Interop.LibraryImportGenerator/Microsoft.Interop.LibraryImportGenerator/LibraryImports.g.cs" Marker="D3D11CreateDevice(" Interface="Windows.Win32.Graphics.Direct3D11.ID3D11DeviceContext" Raw="__ppImmediateContext_native" />
  </ItemGroup>
  <!-- The pinned generator takes the first recognized type attribute. Check the
       exact caller, never only a whole-file Unique occurrence or exported ABI. -->
  <Target Name="CmbVerifyOwnedComMarshalling" AfterTargets="CoreCompile"
          Outputs="%(_CmbOwnedComCaller.Identity)">
    <PropertyGroup>
      <_CmbComStub>$(CompilerGeneratedFilesOutputPath)/%(_CmbOwnedComCaller.Stub)</_CmbComStub>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CmbComStub)')" Text="Missing owned COM caller stub: %(_CmbOwnedComCaller.Marker)" />
    <PropertyGroup>
      <_CmbComText>$([System.IO.File]::ReadAllText('$(_CmbComStub)'))</_CmbComText>
      <_CmbComStart>$(_CmbComText.IndexOf('%(_CmbOwnedComCaller.Marker)'))</_CmbComStart>
    </PropertyGroup>
    <Error Condition="$(_CmbComStart) &lt; 0" Text="Missing exact owned COM caller: %(_CmbOwnedComCaller.Marker)" />
    <PropertyGroup>
      <_CmbComNext>$(_CmbComText.IndexOf('[global::System.CodeDom.Compiler.GeneratedCodeAttribute', $([MSBuild]::Add($(_CmbComStart), 1))))</_CmbComNext>
      <_CmbComNext Condition="$(_CmbComNext) &lt; 0">$(_CmbComText.Length)</_CmbComNext>
      <_CmbComBody>$(_CmbComText.Substring($(_CmbComStart), $([MSBuild]::Subtract($(_CmbComNext), $(_CmbComStart)))))</_CmbComBody>
      <_CmbComUnique>global::System.Runtime.InteropServices.Marshalling.UniqueComInterfaceMarshaller&lt;global::%(_CmbOwnedComCaller.Interface)&gt;</_CmbComUnique>
      <_CmbComShared>global::System.Runtime.InteropServices.Marshalling.ComInterfaceMarshaller&lt;global::%(_CmbOwnedComCaller.Interface)&gt;.ConvertToManaged</_CmbComShared>
    </PropertyGroup>
    <Error Condition="!$(_CmbComBody.Contains('$(_CmbComUnique).ConvertToManaged(%(_CmbOwnedComCaller.Raw))'))" Text="Owned caller conversion changed: %(_CmbOwnedComCaller.Marker)" />
    <Error Condition="!$(_CmbComBody.Contains('$(_CmbComUnique).Free(%(_CmbOwnedComCaller.Raw))')) or !$(_CmbComBody.Contains('finally'))" Text="Owned caller cleanup changed: %(_CmbOwnedComCaller.Marker)" />
    <Error Condition="$(_CmbComBody.Contains('$(_CmbComShared)'))" Text="Shared caller is forbidden: %(_CmbOwnedComCaller.Marker)" />
  </Target>
</Project>
