  "supported_deploy_units": ["LA64.05_UEX", "LB47.05", "LA64.05"],
  "inspectCommands": {
    "darwin": {
      "knowledge_path": "${pluginPath}/sys",
      "project_status": "python3 -X utf8 ${pluginPath}/inspect_state.py --mode project --workspace ${pluginWorkspace} --projects ${projectDirs...}",
      "feature_status": "python3 -X utf8 ${pluginPath}/inspect_state.py --mode run --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature}",
      "create_project": "python3 -X utf8 ${pluginPath}/hooks/init_workspace.py --mode createProject --workspace ${pluginWorkspace} --project ${projectDir}",
      "create_feature": "python3 -X utf8 ${pluginPath}/hooks/init_workspace.py --mode createFeature --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --workflow-template ${workflowTemplate} --workflow-nodes ${workflowNodes} --selected-deployUnit ${selectedDeployUnits}",
      "system_prompt_inject": "\n- FEATURE_DIR：`${pluginWorkspace}/${projectDir}/.autobizdevops/features/${feature}`，这是当前 Feature 产物目录，不得自行定义特性/feature/slug 名称。\n- 调用 `${pluginPath}` 下的脚本时，execute/shell 工具请求省略 `cwd` 字段；状态和产物路径由环境变量或显式参数定位。",
      "plugin_dir_hook": "${pluginWorkspace}/${projectDir}",
      "dialog_tips": "**您正在开发${projectCode} 项目**\n请描述要新增或修改的特性，并说明验收标准。当前产物目录：`${pluginWorkspace}/${projectDir}`",
      "dynamic_workflow": "python3 -X utf8 ${pluginPath}/hooks/inspect_workflow_templates.py",
      "skip_node": "python3 -X utf8 ${pluginPath}/hooks/skip_node.py --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --skip-node ${nodeId}",
      "pull_knowledge": "python3 -X utf8 ${pluginPath}/hooks/sync_agents.py --prefer-manifest --write-board-config",
      "session_context_inject": "python3 -X utf8 ${pluginPath}/hooks/render_collected_session_context.py --platform darwin --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --selected-deployUnit ${selectedDeployUnits} --session-workspace-path ${sessionWorkspacePath} --knowledge-collector ${pluginPath}/hooks/collect-knowledge.js --knowledge-path ${pluginPath}/sys"
    },
    "linux": {
      "knowledge_path": "${pluginPath}/sys",
      "project_status": "python3 -X utf8 ${pluginPath}/inspect_state.py --mode project --workspace ${pluginWorkspace} --projects ${projectDirs...}",
      "feature_status": "python3 -X utf8 ${pluginPath}/inspect_state.py --mode run --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature}",
      "create_project": "python3 -X utf8 ${pluginPath}/hooks/init_workspace.py --mode createProject --workspace ${pluginWorkspace} --project ${projectDir}",
      "create_feature": "python3 -X utf8 ${pluginPath}/hooks/init_workspace.py --mode createFeature --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --workflow-template ${workflowTemplate} --workflow-nodes ${workflowNodes} --selected-deployUnit ${selectedDeployUnits}",
      "system_prompt_inject": "\n- FEATURE_DIR：`${pluginWorkspace}/${projectDir}/.autobizdevops/features/${feature}`，这是当前 Feature 产物目录，不得自行定义特性/feature/slug 名称。\n- 调用 `${pluginPath}` 下的脚本时，execute/shell 工具请求省略 `cwd` 字段；状态和产物路径由环境变量或显式参数定位。",
      "plugin_dir_hook": "${pluginWorkspace}/${projectDir}",
      "dialog_tips": "**您正在开发${projectCode} 项目**\n请描述要新增或修改的特性，并说明验收标准。当前产物目录：`${pluginWorkspace}/${projectDir}`",
      "dynamic_workflow": "python -X utf8 ${pluginPath}/hooks/inspect_workflow_templates.py",
      "skip_node": "python -X utf8 ${pluginPath}/hooks/skip_node.py --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --skip-node ${nodeId}",
      "pull_knowledge": "python3 -X utf8 ${pluginPath}/hooks/sync_agents.py --prefer-manifest --write-board-config",
      "session_context_inject": "python3 -X utf8 ${pluginPath}/hooks/render_collected_session_context.py --platform linux --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --selected-deployUnit ${selectedDeployUnits} --session-workspace-path ${sessionWorkspacePath} --knowledge-collector ${pluginPath}/hooks/collect-knowledge.js --knowledge-path ${pluginPath}/sys"
    },
    "win32": {
      "knowledge_path": "${pluginPath}\\sys",
      "project_status": "python ${pluginPath}\\inspect_state.py --mode project --workspace ${pluginWorkspace} --projects ${projectDirs...}",
      "feature_status": "python ${pluginPath}\\inspect_state.py --mode run --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature}",
      "create_project": "python ${pluginPath}\\hooks\\init_workspace.py --mode createProject --workspace ${pluginWorkspace} --project ${projectDir}",
      "create_feature": "python ${pluginPath}\\hooks\\init_workspace.py --mode createFeature --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --workflow-template ${workflowTemplate} --workflow-nodes ${workflowNodes} --selected-deployUnit ${selectedDeployUnits}",
      "system_prompt_inject": "\n- FEATURE_DIR：`${pluginWorkspace}\\${projectDir}\\.autobizdevops\\features\\${feature}`，这是当前 Feature 产物目录，不得自行定义特性/feature/slug 名称。\n- 调用 `${pluginPath}` 下的脚本时，execute/shell 工具请求省略 `cwd` 字段；状态和产物路径由环境变量或显式参数定位。",
      "plugin_dir_hook": "${pluginWorkspace}\\${projectDir}",
      "dialog_tips": "**您正在开发${projectCode} 项目**\n请描述要新增或修改的特性，并说明验收标准。当前产物目录：`${pluginWorkspace}/${projectDir}`",
      "dynamic_workflow": "python ${pluginPath}\\hooks\\inspect_workflow_templates.py",
      "skip_node": "python ${pluginPath}\\hooks\\skip_node.py --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --skip-node ${nodeId}",
      "pull_knowledge": "python ${pluginPath}\\hooks\\sync_agents.py --prefer-manifest --write-board-config",
      "session_context_inject": "python ${pluginPath}\\hooks\\render_collected_session_context.py --platform win32 --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --selected-deployUnit ${selectedDeployUnits} --session-workspace-path ${sessionWorkspacePath} --knowledge-collector ${pluginPath}\\hooks\\collect-knowledge.js --knowledge-path ${pluginPath}\\sys"
    }
  },
  "workflow": {
    "skipPolicy": {
      "lockedNodes": []
    },
    "templates": {
      "standard": {
        "kind": "profile",
        "label": "标准",
        "description": "完整主干流程（Biz→Dev→Ops），不含可选动态节点；动态节点可在流程中按需开启。"
      },
      "lean": {
        "kind": "nodeSubset",
        "label": "精简路线",
        "description": "修接口 / 小需求：specs（轻量）→ code → 归档；契约不含 design/PLAN，code 直接从 proposal 与 specs 推导任务。",
        "nodes": [
          "dev.specs",
          "dev.code",
          "ops.archive"
        ]
      },
      "custom": {
        "kind": "custom",
        "label": "自选步骤",
        "description": "选择原流程节点并预览依赖与输入缺口；保留所选节点的原检查和人工确认，不跳过实现与归档。",
        "requiredNodes": ["dev.code", "ops.archive"]
      }
    },
    "profiles": {
      "standard": {
        "label": "不需要，进入 autodev-specs",
        "description": "不先转换 HTML 设计稿，直接进入 autodev-specs。"
      }
    },
    "dynamicStages": [
      {
        "id": "detail_design_before_code",
        "phase": "Dev",
        "label": "详细设计",
        "description": "在进入代码实现前生成更细的文件级详细设计。",
        "order": 100,
        "choiceCheckpoint": "plan_done",
        "defaultDecision": "pending",
        "insertAfter": "dev.plan",
        "enableTargetCheckpoint": "detail_design_in_progress",
        "skipTargetCheckpoint": "code_in_progress",
        "enableLabel": "需要，生成详细设计",
        "skipLabel": "不需要，直接编码",
        "enableDescription": "先进入 autodev-detail-design，生成 DETAIL_DESIGN.md 后再进入代码实现。",
        "skipDescription": "不生成 DETAIL_DESIGN.md，直接进入 autodev-code。",
        "nodes": [
          {
            "id": "dev.detail_design",
            "phase": "Dev",
            "label": "详细设计",
            "skill": "autodev-detail-design",
            "checkpointPrefix": "detail_design",
            "description": "生成代码实现前的文件级详细设计 \n 产物：DETAIL_DESIGN.md（文件级详细设计：到文件的修改方案）",
            "artifacts": {
              "inputs": [
                {
                  "id": "proposal",
                  "label": "变更提案",
                  "artifactType": "file",
                  "path": "proposal.md",
                  "required": true,
                  "extract": {
                    "degrade": "无 proposal 时以 specs 与 design 界定范围"
                  }
                },
                {
                  "id": "specs",
                  "label": "行为规格",
                  "artifactType": "file",
                  "path": "specs/**/*.md",
                  "required": true,
                  "extract": {
                    "degrade": "无 specs 时与用户确认行为预期"
                  }
                },
                {
                  "id": "design",
                  "label": "技术设计",
                  "artifactType": "file",
                  "path": "design.md",
                  "required": true,
                  "extract": {
                    "degrade": "无 design 时基于现有代码模式细化方案，并记录设计基准缺失"
                  }
                },
                {
                  "id": "plan_json",
                  "label": "计划机器事实源",
                  "artifactType": "json",
                  "path": "plan.json",
                  "required": true,
                  "extract": {
                    "degrade": "无 plan.json 时回到 /autodev-plan 重新生成，不能只依赖 PLAN.md 推进详细设计"
                  }
                }
              ],
              "outputs": [
                {
                  "id": "detail_design",
                  "label": "详细设计",
                  "artifactType": "file",
                  "path": "DETAIL_DESIGN.md",
                  "required": true
                }
              ]
            },
            "validators": []
          }
        ]
      }
    ],
    "checkpoints": {
      "initial": [
        "prd_in_progress",
        "specs_in_progress",
        "design_in_progress",
        "plan_in_progress",
        "cicd_in_progress"
      ],
      "transitions": {
        "prd_in_progress": [
          "prd_done"
        ],
        "prd_done": [
          "specs_in_progress"
        ],
        "specs_in_progress": [
          "specs_done"
        ],
        "specs_done": [
          "design_in_progress"
        ],
        "design_in_progress": [
          "design_done"
        ],
        "design_done": [
          "plan_in_progress"
        ],
        "plan_in_progress": [
          "plan_done"
        ],
        "plan_done": [
          "code_in_progress"
        ],
        "code_in_progress": [
          "code_done"
        ],
        "code_done": [
          "cicd_in_progress"
        ],
        "cicd_in_progress": [
          "cicd_done"
        ],
        "cicd_done": [
          "archived"
        ],
        "needs_fix": [
          "prd_in_progress",
          "specs_in_progress",
          "design_in_progress",
          "plan_in_progress",
          "code_in_progress",
          "cicd_in_progress"
        ],
        "archived": []
      },
      "stageLabels": {
        "prd_in_progress": "Biz / 需求澄清与 PRD",
        "prd_done": "Biz / PRD",
        "specs_in_progress": "Specs",
        "specs_done": "Specs 完成",
        "design_in_progress": "技术设计",
        "design_done": "技术设计完成",
        "plan_in_progress": "Plan",
        "plan_done": "Plan 完成",
        "code_in_progress": "Code",
        "code_done": "Code 完成",
        "cicd_in_progress": "CI/CD",
        "cicd_done": "CI/CD 完成",
        "needs_fix": "需要修复",
        "archived": "已归档"
      }
    },
    "nodes": [
      {
        "id": "biz.prd",
        "label": "需求澄清与 PRD",
        "group": "Biz",
        "skill": "autobiz-requirement-discuss",
        "order": 10,
        "runtimePolicy": {
          "agentMode": "multi",
          "toolCustomConfig": {
            "task": {
              "enabled": true
            }
          }
        },
        "description": "澄清需求并生成正式 PRD 文档 \n 产物：PRD.md（产品需求文档：业务目标、用户场景与验收标准）、UI_CONTEXT.json（UI 范围机器事实源）",
        "states": [
          {
            "nodeStatus": "not_started",
            "label": "未开始",
            "nextAction": {
              "slashSkill": "autobiz-requirement-discuss",
              "userMessage": "请使用 /autobiz-requirement-discuss 继续推进当前 Feature。",
              "dialogTips": "当前阶段：需求澄清与 PRD。"
            }
          },
          {
            "nodeStatus": "in_progress",
            "label": "进行中",
            "nextAction": {
              "slashSkill": "autobiz-requirement-discuss",
              "userMessage": "请使用 /autobiz-requirement-discuss 继续推进当前 Feature。",
              "dialogTips": "当前阶段：需求澄清与 PRD。"
            }
          },
          {
            "nodeStatus": "done",
            "label": "已完成",
            "nextAction": {
              "slashSkill": "autodev-specs",
              "userMessage": "请使用 /autodev-specs 继续推进当前 Feature。",
              "dialogTips": "通过 /autodev-specs 路由到行为规格；UI 范围以 UI_CONTEXT.json 为机器事实源，前端实现后续在 /autodev-code 内部按 FRONTEND_ROUTE.json 分流。"
            }
          }
        ],
        "checkpoints": [
          "prd_in_progress",
          "prd_done"
        ],
        "artifacts": {
          "inputs": [],
          "outputs": [
            {
              "id": "prd",
              "label": "PRD文档",
              "artifactType": "file",
              "path": "PRD.md",
              "required": true
            },
            {
              "id": "ui_context_json",
              "label": "UI范围机器事实源",
              "artifactType": "json",
              "path": "UI_CONTEXT.json",
              "required": true
            }
          ]
        },
        "validators": [
          "ui_context_json"
        ],
        "hookDefinitions": [
          {
            "id": "biz-prd-validate",
            "label": "PRD 产物校验",
            "event": "PostSkillUse",
            "required": true
          }
        ]
      },
      {
        "id": "dev.specs",
        "label": "行为规格",
        "group": "Dev",
        "skill": "autodev-specs",
        "order": 30,
        "runtimePolicy": {
          "agentMode": "multi",
          "toolCustomConfig": {
            "task": {
              "enabled": true
            }
          },
          "subagentConfig": {
            "disabledBuiltinSubagents": [
              "Explore",
              "critic"
            ],
            "customSubagentFiles": [
              "agents/explore.md",
              "agents/critic.md"
            ]
          }
        },
        "description": "生成 proposal 与行为规格 \n 产物：proposal.md（变更提案：本轮目标、范围与非目标）、specs/**/*.md（行为规格：各能力 Requirement/Scenario 契约）",
        "states": [
          {
            "nodeStatus": "not_started",
            "label": "未开始",
            "nextAction": {
              "slashSkill": "autodev-specs",
              "userMessage": "请使用 /autodev-specs 继续推进当前 Feature。",
              "dialogTips": "当前阶段：行为规格。"
            }
          },
          {
            "nodeStatus": "in_progress",
            "label": "进行中",
            "nextAction": {
              "slashSkill": "autodev-specs",
              "userMessage": "请使用 /autodev-specs 继续推进当前 Feature。",
              "dialogTips": "当前阶段：行为规格。"
            }
          },
          {
            "nodeStatus": "done",
            "label": "已完成",
            "nextAction": {
              "slashSkill": "autodev-design",
              "userMessage": "请使用 /autodev-design 继续推进当前 Feature。",
              "dialogTips": "当前阶段：技术设计。"
            }
          }
        ],
        "checkpoints": [
          "specs_in_progress",
          "specs_done"
        ],
        "artifacts": {
          "inputs": [
            {
              "id": "prd",
              "label": "PRD文档",
              "artifactType": "file",
              "path": "PRD.md",
              "required": true,
              "extract": {
                "degrade": "无 PRD 时基于用户描述直接澄清行为契约，沉淀到 proposal 与 specs"
              }
            },
            {
              "id": "ui_context_json",
              "label": "UI范围",
              "artifactType": "json",
              "path": "UI_CONTEXT.json",
              "required": true,
              "extract": {
                "degrade": "无 UI_CONTEXT.json 时，本阶段必须基于用户已确认范围生成并锁定，不能从 PRD 正文临时推导"
              }
            }
          ],
          "outputs": [
            {
              "id": "proposal",
              "label": "变更提案",
              "artifactType": "file",
              "path": "proposal.md",
              "required": true
            },
            {
              "id": "specs",
              "label": "行为规格",
              "artifactType": "file",
              "path": "specs/**/*.md",
              "required": true
            },
            {
              "id": "ui_context_json",
              "label": "UI范围",
              "artifactType": "json",
              "path": "UI_CONTEXT.json",
              "required": true
            }
          ]
        },
        "validators": [
          "proposal_contract",
          "specs_contract",
          "capability_spec_correspondence",
          "ui_context_json"
        ]
      },
      {
        "id": "dev.design",
        "label": "技术设计",
        "group": "Dev",
        "skill": "autodev-design",
        "order": 40,
        "runtimePolicy": {
          "agentMode": "multi",
          "toolCustomConfig": {
            "task": {
              "enabled": true
            }
          },
          "subagentConfig": {
            "disabledBuiltinSubagents": [
              "Explore",
              "critic"
            ],
            "customSubagentFiles": [
              "agents/explore.md",
              "agents/critic_autodev_design_zh.md"
            ]
          }
        },
        "description": "探索并生成技术设计 \n 产物：design.md 与 .design-contract.lock.json（已校验的 API/数据/技术决策快照）",
        "states": [
          {
            "nodeStatus": "not_started",
            "label": "未开始",
            "nextAction": {
              "slashSkill": "autodev-design",
              "userMessage": "请使用 /autodev-design 继续推进当前 Feature。",
              "dialogTips": "当前阶段：技术设计。"
            }
          },
          {
            "nodeStatus": "in_progress",
            "label": "进行中",
            "nextAction": {
              "slashSkill": "autodev-design",
              "userMessage": "请使用 /autodev-design 继续推进当前 Feature。",
              "dialogTips": "当前阶段：技术设计。"
            }
          },
          {
            "nodeStatus": "done",
            "label": "已完成",
            "nextAction": {
              "slashSkill": "autodev-plan",
              "userMessage": "请使用 /autodev-plan 继续推进当前 Feature。",
              "dialogTips": "当前阶段：执行计划。"
            }
          }
        ],
        "checkpoints": [
          "design_in_progress",
          "design_done"
        ],
        "artifacts": {
          "inputs": [
            {
              "id": "proposal",
              "label": "变更提案",
              "artifactType": "file",
              "path": "proposal.md",
              "required": true,
              "extract": {
                "degrade": "无 proposal 时基于用户直供需求与代码探索建立上下文，并把边界假设记入 design.md 风险"
              }
            },
            {
              "id": "specs",
              "label": "行为规格",
              "artifactType": "file",
              "path": "specs/**/*.md",
              "required": true,
              "extract": {
                "degrade": "无 specs 时与用户确认行为预期后再设计，未确认行为全部记为待确认风险"
              }
            },
            {
              "id": "ui_context_json",
              "label": "UI范围",
              "artifactType": "json",
              "path": "UI_CONTEXT.json",
              "required": true,
              "extract": {
                "degrade": "无 UI_CONTEXT.json 时回到 /autodev-specs 补齐并锁定，不能自行推断 UI 范围"
              }
            }
          ],
          "outputs": [
            {
              "id": "design",
              "label": "技术设计",
              "artifactType": "file",
              "path": "design.md",
              "required": true
            },
            {
              "id": "design_contract_lock",
              "label": "设计契约锁",
              "artifactType": "json",
              "path": ".design-contract.lock.json",
              "required": true
            }
          ]
        },
        "validators": [
          "design_contract",
          "design_contract_lock",
          "ui_context_json"
        ]
      },
      {
