    "/api/bot/v1/runs": {"parameters":[{"$ref":"#/components/parameters/Space"}],"post":{"operationId":"createRun","description":"expectedVersion refers to Task. Server resolves Bot/config/context/grant/workspace; public callers cannot submit RunSpec. Missing capabilities fail explicitly; offline nodes wait, not succeed.","requestBody":{"$ref":"#/components/requestBodies/CreateRun"},"responses":{"202":{"$ref":"#/components/responses/Run"},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
