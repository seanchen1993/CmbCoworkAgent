{
  "openapi":"3.1.0",
  "info":{"title":"DevClaw Bot v1 (frozen contract, not a deployed service)","version":"1.0.0","description":"DTOs are references to one offline JSON Schema 2020-12 source. Commands require authenticated membership; body identity is forbidden. Reauthorize before replay; receipt lookup before current CAS. No production authorization or exactly-once claim."},
