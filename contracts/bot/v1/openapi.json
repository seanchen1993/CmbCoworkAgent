    "/api/bot/v1/runs/{runId}/cancel": {"parameters":[{"$ref":"#/components/parameters/Space"},{"$ref":"#/components/parameters/RunId"}],"post":{"operationId":"cancelRun","description":"202 means cancel_requested, not proof of stopped execution; completion can win the race.","requestBody":{"$ref":"#/components/requestBodies/CancelRun"},"responses":{"202":{"$ref":"#/components/responses/Run"},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/api/bot/v1/events": {"parameters":[{"$ref":"#/components/parameters/Space"}],"get":{"operationId":"getEvents","description":"Without after, return empty events and current head cursor only. Each increment reauthorizes; cursor is not an access grant. Expired cursor returns 410 and requires resync.","parameters":[{"name":"after","in":"query","required":false,"schema":{"$ref":"./schemas.json#/$defs/Cursor"}},{"name":"limit","in":"query","required":false,"schema":{"$ref":"./schemas.json#/$defs/EventLimit"}}],"responses":{"200":{"$ref":"#/components/responses/Events"},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"410":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/api/bot/v1/runtime/ws": {"get":{"operationId":"connectRuntime","security":[{"nodeCredential":[]}],"description":"Runtime initiates outbound WSS. Independent node credential binds authenticated nodeId and spaceId at handshake, never a client-reported body identity. Upgrade itself is not Runtime registration or execution success; every message validates runtime.schema.json. Reconnect does not execute tools.","responses":{"101":{"description":"WebSocket upgrade; messages use runtime.schema.json, no HTTP DTO body."},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}},"x-runtime-message-schema":{"$ref":"./runtime.schema.json"}}}
  },
  "components": {
    "securitySchemes":{"bearerIdentity":{"type":"http","scheme":"bearer","description":"Authenticated user/service identity, independently authorized per space/resource."},"nodeCredential":{"type":"http","scheme":"bearer","description":"Separate node identity credential bound to node and space; not an end-user bearer token."}},
    "parameters": {
      "Space":{"name":"X-DevClaw-Space","in":"header","required":true,"description":"Selector only; membership and permissions are checked by server.","schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "BotId":{"name":"botId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "GroupId":{"name":"groupId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "TaskId":{"name":"taskId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "UploadId":{"name":"uploadId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "ArtifactId":{"name":"artifactId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "VersionId":{"name":"versionId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "ApprovalId":{"name":"approvalId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},
      "RunId":{"name":"runId","in":"path","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}}
    },
    "requestBodies": {
      "CreateBot":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateBotRequest"}}}},
      "CreateBotVersion":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateBotVersionRequest"}}}},
      "CreateGroup":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateGroupRequest"}}}},
      "UpdateGroupMembers":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/UpdateGroupMembersRequest"}}}},
      "CreateTask":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateTaskRequest"}}}},
      "CreateTaskMessage":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateTaskMessageRequest"}}}},
      "TransitionStage":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/TransitionStageRequest"}}}},
      "CreateUpload":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateUploadRequest"}}}},
      "CompleteUpload":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CompleteUploadRequest"}}}},
      "CreateArtifact":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateArtifactRequest"}}}},
      "CreateArtifactVersion":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateArtifactVersionRequest"}}}},
      "CreateApproval":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateApprovalRequest"}}}},
      "DecideApproval":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/DecideApprovalRequest"}}}},
      "CreateHandoff":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateHandoffRequest"}}}},
      "CreateDevelopmentHandoff":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateDevelopmentHandoffRequest"}}}},
      "CreateRun":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CreateRunRequest"}}}},
      "CancelRun":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/CancelRunRequest"}}}}
    },
    "responses": {
      "Error":{"description":"Safe error; no stack, credentials or upstream response. Code-to-status mapping is in x-error-status. OUTCOME_UNKNOWN must not advertise automatic retry.","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/ErrorResponse"}}}},
      "Bot":{"description":"Bot and immutable configuration version","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/BotResult"}}}},
      "Group":{"description":"Versioned independent collaboration Group","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/GroupResult"}}}},
      "Task":{"description":"Authoritative versioned Task","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/TaskResult"}}}},
      "TaskSnapshot":{"description":"Consistent Task and increment starting cursor","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/TaskSnapshotResult"}}}},
      "TaskMessage":{"description":"Message and new Task CAS version","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/TaskMessageResult"}}}},
      "Upload":{"description":"Upload state; no storage URL or credential","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/UploadResult"}}}},
      "Artifact":{"description":"Artifact and immutable content version","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/ArtifactResult"}}}},
      "ArtifactVersion":{"description":"Immutable ArtifactVersion metadata","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/ArtifactVersionResult"}}}},
      "Approval":{"description":"Separate version-bound approval kind","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/ApprovalResult"}}}},
      "ApprovalDecision":{"description":"Approval and server-attributed decision","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/ApprovalDecisionResult"}}}},
      "Handoff":{"description":"Accepted pending partner handoff","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/HandoffResult"}}}},
      "DevelopmentHandoff":{"description":"Immutable dual-confirmed package, not execution","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/DevelopmentHandoffResult"}}}},
      "Run":{"description":"Run state, not implicit success","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/RunResult"}}}},
      "RunDetail":{"description":"Run and distinct actual dispatch attempts","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/RunDetailResult"}}}},
      "Events":{"description":"Authorized references and reliable next cursor","content":{"application/json":{"schema":{"$ref":"./schemas.json#/$defs/EventsResult"}}}}
    }
  },
  "x-error-status":{"INVALID_PAYLOAD":400,"SCHEMA_VERSION_UNSUPPORTED":400,"UNAUTHENTICATED":401,"FORBIDDEN":403,"NOT_FOUND":404,"VERSION_CONFLICT":409,"COMMAND_CONFLICT":409,"COMMAND_EXPIRED":409,"INPUT_CHANGED":409,"APPROVAL_REQUIRED":409,"APPROVAL_EXPIRED":409,"NODE_OFFLINE":409,"CAPABILITY_UNAVAILABLE":409,"OUTCOME_UNKNOWN":409,"CURSOR_EXPIRED":410,"PAYLOAD_TOO_LARGE":413,"RATE_LIMITED":429,"DEPENDENCY_UNAVAILABLE":503}
}
