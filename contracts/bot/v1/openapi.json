    "/api/bot/v1/uploads": {"parameters":[{"$ref":"#/components/parameters/Space"}],"post":{"operationId":"createUpload","requestBody":{"$ref":"#/components/requestBodies/CreateUpload"},"responses":{"201":{"$ref":"#/components/responses/Upload"},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/api/bot/v1/uploads/{uploadId}/content": {"parameters":[{"$ref":"#/components/parameters/Space"},{"$ref":"#/components/parameters/UploadId"}],"put":{"operationId":"putUploadContent","description":"Authenticated binary proxy. No presigned S3 URL is returned to a model. X-Command-Id is part of command deduplication; binary fingerprint includes the verified byte digest, media type, If-Match and canonical path.","parameters":[{"name":"X-Command-Id","in":"header","required":true,"schema":{"$ref":"./schemas.json#/$defs/Id"}},{"name":"If-Match","in":"header","required":true,"schema":{"$ref":"./schemas.json#/$defs/IfMatchVersion"}}],"requestBody":{"required":true,"content":{"application/octet-stream":{"schema":{"$ref":"./schemas.json#/$defs/BinaryContent"}}}},"responses":{"200":{"$ref":"#/components/responses/Upload"},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/api/bot/v1/uploads/{uploadId}/complete": {"parameters":[{"$ref":"#/components/parameters/Space"},{"$ref":"#/components/parameters/UploadId"}],"post":{"operationId":"completeUpload","description":"202 means verifying only; 200 means committed after byte/type/safety verification. Replay does not reopen committed content.","requestBody":{"$ref":"#/components/requestBodies/CompleteUpload"},"responses":{"200":{"$ref":"#/components/responses/Upload"},"202":{"$ref":"#/components/responses/Upload"},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/api/bot/v1/tasks/{taskId}/artifacts": {"parameters":[{"$ref":"#/components/parameters/Space"},{"$ref":"#/components/parameters/TaskId"}],"post":{"operationId":"createArtifact","description":"Upload must be committed, belong to this Task, and have purpose equal to kind; purpose alone is not authorization.","requestBody":{"$ref":"#/components/requestBodies/CreateArtifact"},"responses":{"201":{"$ref":"#/components/responses/Artifact"},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
