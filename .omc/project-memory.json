    "devCommand": "npm run dev",
    "scripts": {
      "format": "prettier --write .",
      "lint": "eslint --cache .",
      "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
      "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
      "typecheck": "npm run typecheck:node && npm run typecheck:web",
      "test": "vitest run && npm run test:hooks && npm run test:plugins && npm run test:task-cards && npm run test:merge",
      "test:merge": "npx tsx tests/skill-bundle-merge.spec.ts && npx tsx tests/skill-bundle-version.spec.ts",
      "test:hooks": "npx tsx tests/hook-cc-field-alignment.spec.ts && npx tsx tests/hook-timeout-bounds.spec.ts && npx tsx tests/hook-phase2-spec.spec.ts && npx tsx tests/hook-phase2-followup.spec.ts && npx tsx tests/git-hook-collection-path.spec.ts",
      "test:plugins": "npx tsx tests/plugin-inspect-zip.spec.ts && npx tsx tests/plugin-market-version.spec.ts && npx vitest run src/main/ipc/plugins-market-sim.test.ts",
      "test:task-cards": "npx tsx tests/task-cards.spec.ts",
      "test:watch": "vitest",
      "test:goal:unit": "npx tsx tests/goals.spec.ts && npx tsx tests/goals-db.spec.ts && npx tsx tests/goals-evaluator.spec.ts && npx tsx tests/goals-runtime-harness.spec.ts && npx tsx tests/goal-notice-ui.spec.ts && npx tsx tests/goal-transcript.spec.ts && npx tsx tests/goal-panel-view.spec.ts && npx tsx tests/goal-ui-events.spec.ts && npx tsx tests/checkpoint-message-times.spec.ts && npx tsx tests/thread-values-merge.spec.ts && npx tsx tests/submit-in-flight-lock.spec.ts && npx tsx tests/goal-control-submit.spec.ts && npx tsx tests/live-stream-messages.spec.ts && npx tsx tests/stream-message-ids.spec.ts",
      "test:goal:integration": "npx tsx tests/goal-ipc-e2e.spec.ts",
      "test:goal": "npm run test:goal:unit && npm run test:goal:integration",
      "test:goal:e2e": "RUN_GOAL_E2E_REAL_MODEL=1 npx tsx tests/goal-ipc-e2e.spec.ts",
      "start": "electron-vite preview",
      "dev": "electron-vite dev",
      "dev:mock-task-cards": "node -e \"const { spawnSync } = require('child_process'); process.env.CMB_TASK_CARDS_MOCK = '1'; const result = spawnSync('electron-vite', ['dev'], { stdio: 'inherit', shell: true, env: process.env }); process.exit(result.status ?? 1)\"",
      "build": "electron-vite build",
      "clean:win-code-exe": "node -e \"require('fs').rmSync('resources/bin/win32/codex.exe', { force: true })\"",
      "predist": "npm run clean:win-code-exe",
      "predist:win": "npm run clean:win-code-exe",
      "predist:mac": "npm run clean:win-code-exe",
      "dist": "npm run build && electron-builder",
      "dist:win": "npm run build && electron-builder --win",
      "dist:mac": "npm run build && electron-builder --mac",
      "dist:linux": "npm run build && electron-builder --linux --x64 --publish=never",
      "server:cache": "node scripts/server-cache.js",
      "postinstall": "electron-rebuild -f -w node-pty",
      "env:filter:setup": "node scripts/setup-env-filter.mjs",
      "env:encrypt": "node scripts/env-crypt.mjs encrypt-file .env",
      "env:decrypt": "node scripts/env-crypt.mjs decrypt-file .env",
      "env:encrypt:quick": "git add --renormalize .env && git show :.env | head -n 1",
      "env:decrypt:quick": "rm -f .env && git checkout -- .env",
      "env:filter:disable": "git config --local --unset filter.envcrypt.clean; git config --local --unset filter.envcrypt.smudge; git config --local --unset filter.envcrypt.required"
    }
  },
