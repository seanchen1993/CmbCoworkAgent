{
  "apiVersion": "cmb.mods/v2",
  "id": "test-verification",
  "claw": {
    "componentsVersion": 1,
    "components": [
      {
        "id": "main",
        "name": "独立测试验证",
        "kind": "module",
        "entry": "main.ts",
        "dependsOn": [],
        "actionIds": ["execute-e2e", "e2e"]
      }
    ],
    "actions": [
      {
        "id": "execute-e2e",
        "name": "执行显式 Node 测试；由 e2e 独立核对 Host 配置期望",
        "platform": { "id": "test-verification", "version": "2.0.0", "action": "execute-e2e" },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "sources", "timeoutMs"],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifactId", "path", "maxBytes"],
                "properties": {
                  "artifactId": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "path": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "maxBytes": { "type": "integer", "enum": [28000, 524288] }
                }
              }
            },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 160 }
            },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 }
          }
        },
        "outputSchema": { "type": "object" }
      },
      {
        "id": "e2e",
        "name": "按 Host 实际配置核对原始测试回执及入口",
        "platform": { "id": "test-verification", "version": "2.0.0", "action": "e2e" },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "projectId",
            "stageId",
            "version",
            "pluginDigest",
            "workspaceIdentity",
            "current",
            "sources"
          ],
          "properties": {
            "protocol": { "type": "string", "enum": ["devclaw.artifact-input/v1"] },
            "projectId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "stageId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "version": { "type": "integer", "minimum": 1 },
            "pluginDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
            "workspaceIdentity": { "type": "string", "minLength": 64, "maxLength": 64 },
            "current": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifactId", "path", "bytes", "sha256", "maxBytes"],
              "properties": {
                "artifactId": { "type": "string", "minLength": 1, "maxLength": 100 },
                "path": { "type": "string", "minLength": 1, "maxLength": 160 },
                "bytes": { "type": "integer", "minimum": 0, "maximum": 28000 },
                "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "maxBytes": { "type": "integer", "enum": [28000] }
              }
            },
            "configuration": {
              "type": "object",
              "description": "Host 根据当前检查 configurationKeys 注入的实际原生用户配置；不是报告、执行参数或静态 action config。",
              "additionalProperties": false,
              "required": ["e2eTestFiles", "e2eSubjects", "e2eTimeoutMs"],
              "properties": {
                "e2eTestFiles": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "1–4个实际测试相对路径组成的JSON字符串数组文本。"
                },
                "e2eSubjects": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "1–8个实际被测相对路径组成的JSON字符串数组文本。"
                },
                "e2eTimeoutMs": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 300000,
                  "description": "实际原生表单中的整数超时；须与真实执行严格相同。"
                }
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifactId", "path", "bytes", "sha256", "maxBytes"],
                "properties": {
                  "artifactId": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "path": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "bytes": { "type": "integer", "minimum": 0, "maximum": 524288 },
                  "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "maxBytes": { "type": "integer", "enum": [28000, 524288] }
                }
              }
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": ["passed", "expectedEntryBound", "errors", "warnings"],
          "properties": {
            "passed": { "type": "boolean" },
            "expectedEntryBound": { "type": "boolean" },
            "errors": { "type": "array" },
            "warnings": { "type": "array" }
          }
        },
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nativeCompositionProvider"],
          "properties": {
            "allowLegacyInput": {
              "type": "boolean",
              "enum": [true],
              "description": "仅明确兼容无configurationKeys的旧调用；返回未绑定UI期望警告，新原生阶段禁用。"
            },
            "nativeCompositionProvider": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pluginId", "plugin", "digest", "actionId"],
              "properties": {
                "pluginId": { "type": "string" },
                "plugin": { "type": "string" },
                "digest": { "type": "string" },
                "actionId": { "type": "string" }
              }
            }
          }
        }
      }
    ]
  }
}
