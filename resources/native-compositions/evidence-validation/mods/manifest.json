{
  "apiVersion": "cmb.mods/v2",
  "id": "evidence-validation",
  "claw": {
    "componentsVersion": 1,
    "components": [
      {
        "id": "main",
        "name": "来源与摘要衔接校验",
        "description": "核对真实来源中的逐字引用以及报告与上游摘要字段的一致性；不判断事实真实性。",
        "kind": "module",
        "entry": "main.ts",
        "dependsOn": [],
        "actionIds": [
          "check-citations",
          "check-report"
        ]
      }
    ],
    "actions": [
      {
        "id": "check-citations",
        "name": "来源存在及逐字引用校验",
        "platform": {
          "id": "evidence-validation",
          "version": "1.0.0",
          "action": "check-citations"
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "projectId",
            "stageId",
            "version",
            "pluginDigest",
            "workspaceIdentity",
            "current",
            "sources"
          ],
          "properties": {
            "protocol": {
              "const": "devclaw.artifact-input/v1"
            },
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "stageId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "pluginDigest": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "current": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactId",
                "path",
                "bytes",
                "sha256",
                "maxBytes"
              ],
              "properties": {
                "artifactId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 524288
                }
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifactId",
                  "path",
                  "bytes",
                  "sha256",
                  "maxBytes"
                ],
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65536
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 524288
                  }
                }
              }
            }
          }
        },
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceArtifactId"
          ],
          "properties": {
            "sourceArtifactId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": [
            "passed",
            "errors",
            "warnings",
            "scope"
          ],
          "additionalProperties": false,
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "maxItems": 210,
              "items": {
                "type": "object",
                "required": [
                  "code"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "maxItems": 0
            },
            "scope": {
              "const": "exact-quotes-and-field-equality-only"
            }
          }
        }
      },
      {
        "id": "check-report",
        "name": "报告沿用上游摘要与引用校验",
        "platform": {
          "id": "evidence-validation",
          "version": "1.0.0",
          "action": "check-report"
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "projectId",
            "stageId",
            "version",
            "pluginDigest",
            "workspaceIdentity",
            "current",
