              "type": "integer",
              "minimum": 1
            },
            "pluginDigest": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "workspaceIdentity": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "current": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactId",
                "path",
                "bytes",
                "sha256",
                "maxBytes"
              ],
              "properties": {
                "artifactId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 524288
                }
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifactId",
                  "path",
                  "bytes",
                  "sha256",
                  "maxBytes"
                ],
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65536
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 524288
                  }
                }
              }
            }
          }
        },
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceArtifactId",
            "summaryArtifactId"
          ],
          "properties": {
            "sourceArtifactId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "summaryArtifactId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": [
            "passed",
            "errors",
            "warnings",
            "scope"
          ],
          "additionalProperties": false,
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "maxItems": 210,
              "items": {
                "type": "object",
                "required": [
                  "code"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "maxItems": 0
            },
            "scope": {
              "const": "exact-quotes-and-field-equality-only"
            }
          }
        }
      }
    ]
  }
}
