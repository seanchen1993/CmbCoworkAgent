.env filter=envcrypt
resources/mods/community-originals/** -text
tests/fixtures/mods-upstream/** -text
tests/fixtures/autobiz-reviewed-hooks.json -text
tests/fixtures/autobiz-reviewed/base/** -text
tests/fixtures/autobiz-reviewed/observer/** -text
tests/fixtures/autobiz-reviewed/archives/** -text
# Patch, manifest and template checksums require the exact committed bytes on every OS.
patches/** -text
# Generated collector bytes are pinned by fixtures and must survive Windows checkout unchanged.
resources/mods/autobiz-knowledge/collector-gray-matter.cjs -text
resources/mods/autobiz-knowledge/collector-THIRD-PARTY-NOTICES.md -text
# The reviewed AutoBiz Plan Writer is assembled and verified by its exact byte digest.
resources/mods/autobiz-plan-merge/verified-merge-projection.py.inc text eol=lf
# Historical AutoBiz profiles were reviewed with different line endings.
src/main/plugins/autobiz-business-kernel-reviewed.json text eol=crlf
src/main/plugins/autobiz-business-kernel-merge-reviewed.json text eol=lf
# Built-in platform examples are verified byte-for-byte on every supported checkout.
examples/sparks-task-workbench/** text eol=lf
examples/sparks-edit-reminder/** text eol=lf
examples/sparks-stage-debugger/** text eol=lf
examples/developer-workbench/** text eol=lf
examples/frontend-api-workbench/demo/start-demo.cmd text eol=crlf
examples/frontend-api-workbench/demo/public/vendor/** -text
examples/frontend-api-starter/start-demo.cmd text eol=crlf
examples/frontend-api-starter/public/vendor/** -text

# Native composition resources carry provenance hashes and must retain LF bytes.
resources/native-compositions/** text eol=lf
tests/fixtures/native-compositions/** text eol=lf
