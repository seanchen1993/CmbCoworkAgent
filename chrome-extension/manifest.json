{
  "manifest_version": 3,
  "name": "CmbCoworkAgent Browser Importer",
  "version": "0.1.2",
  "description": "Import Chrome cookies into CmbCoworkAgent without reading Chrome profile files.",
  "permissions": ["cookies", "nativeMessaging", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "CmbCoworkAgent Cookie Importer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
